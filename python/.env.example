# Archon Environment Configuration

# ============================================================================
# REQUIRED: Database Configuration
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ============================================================================
# REQUIRED: AI Provider Configuration
# ============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================================================
# OPTIONAL: Slack Integration (Phase 1)
# ============================================================================
# Get these from https://api.slack.com/apps
SLACK_CLIENT_ID="8216307713604.9727696163189"
SLACK_CLIENT_SECRET="89d9834acad7fceca1e4fb33588ecfd9"
SLACK_SIGNING_SECRET="de6d92468c146d62e30506670145fb2b"

# ============================================================================
# OPTIONAL: Asana Integration (Phase 1)
# ============================================================================
# Get these from https://app.asana.com/0/my-apps
ASANA_CLIENT_ID=your-asana-client-id
ASANA_CLIENT_SECRET=your-asana-client-secret
ASANA_WEBHOOK_SECRET=your-webhook-secret-here

# ============================================================================
# OPTIONAL: Application Configuration
# ============================================================================
# Environment
PRODUCTION=false
APP_BASE_URL=http://localhost:8181

# Server
PORT=8181
HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO

# ============================================================================
# OPTIONAL: Feature Flags
# ============================================================================
# Enable/disable features
ENABLE_PROJECTS=true
ENABLE_AI_AGENTS=true
ENABLE_INTEGRATIONS=true

# ============================================================================
# OPTIONAL: AI-PM Automation (Phase 2)
# ============================================================================
# Enable automated task execution via Claude Code CLI
# When enabled, tasks created via /aipm will be automatically implemented
AUTO_EXECUTE_TASKS=false

# Path to Claude Code CLI executable
# Leave empty to use 'claude-code' from PATH
CLAUDE_CODE_PATH=

# Working directory for Claude Code execution
# Leave empty to use current directory
WORKSPACE_PATH=

# Claude Code execution timeout in seconds (default: 600 = 10 minutes)
CLAUDE_CODE_TIMEOUT=600

# ============================================================================
# OPTIONAL: Rate Limiting
# ============================================================================
# OpenAI rate limits (requests per minute)
OPENAI_RATE_LIMIT=50

# Asana rate limits (requests per minute)
ASANA_RATE_LIMIT=150

# Slack rate limits (requests per second)
SLACK_RATE_LIMIT=1

# ============================================================================
# OPTIONAL: Ollama Configuration (Local LLM)
# ============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ============================================================================
# OPTIONAL: Advanced Configuration
# ============================================================================
# Token encryption (for production)
# TOKEN_ENCRYPTION_KEY=your-32-byte-encryption-key

# Database connection pool
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# Request timeouts (seconds)
# HTTP_TIMEOUT=30
# WEBHOOK_TIMEOUT=10

# ============================================================================
# Development Only
# ============================================================================
# Debug mode
# DEBUG=true

# Disable auth (development only!)
# DISABLE_AUTH=false
